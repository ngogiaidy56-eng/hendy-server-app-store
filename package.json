{
  "name": "hendy-tool-releas",
  "private": true,
  "version": "3.2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/prepare-worker-assets.mjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts",
    "deploy:worker": "node scripts/prepare-worker-assets.mjs && npx --yes wrangler@4 deploy --config=wrangler.toml",
    "deploy:pages": "npx --yes wrangler@4 pages deploy dist --project-name=hendy-tool-releas --branch=main",
    "package:web-release": "node scripts/package-web-release.mjs",
    "provision:cloudflare:resources": "node scripts/provision-cloudflare-resources.mjs",
    "provision:cloudflare:access": "node scripts/provision-cloudflare-access.mjs",
    "smoke:cloudflare": "node scripts/smoke-test-cloudflare.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
