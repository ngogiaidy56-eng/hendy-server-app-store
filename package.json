{
  "name": "hendy-server-app-store",
  "private": true,
  "version": "3.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/web-user",
    "apps/web-admin",
    "packages/shared-types",
    "packages/db-schema"
  ],
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "build": "vite build && node automation/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts tests/*.test.mjs",
    "verify:build": "node automation/verify-build.mjs",
    "db:migrate": "node scripts/migrate-render.mjs",
    "smoke:render": "node automation/smoke-test-render.mjs",
    "package:web-release": "node scripts/package-web-release.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.1.0",
    "firebase": "^13.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
