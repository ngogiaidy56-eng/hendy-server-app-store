# Public values only. Never commit credentials or private keys.
NODE_ENV=development
PORT=10000
APP_NAME=Hendy App Store
ENVIRONMENT=development
RELEASE_CHANNEL=stable
PUBLIC_BASE_URL=http://localhost:10000

# Local PostgreSQL connection. In Render, DATABASE_URL is linked from the
# hendy-app-store-db resource by render.yaml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hendy_app_store
PGSSLMODE=disable
PGPOOL_MAX=10

# Required secrets: set only in Render Dashboard > Environment.
# ADMIN_USERNAME
# ADMIN_PASSWORD (at least 20 characters)
# ADMIN_EMAIL
# RELEASE_PUBLISH_TOKEN (at least 32 random characters)
# CERTIFICATE_ENCRYPTION_KEY (Base64 encoding of exactly 32 random bytes)
