# Local development only. Never commit real secrets or production manifests.
PORT=10000
NODE_ENV=development

# Without DATABASE_URL, public read routes use this read-only JSON fallback.
RELEASES_JSON=[]

# Admin API: use a long random value; configure only as a hosting secret.
ADMIN_API_TOKEN=replace-with-a-long-random-secret

# PostgreSQL persistence (required for administrative mutations on Render).
DATABASE_URL=

# Cloudflare R2 S3-compatible API (required for upload/delete from the Render backend).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://downloads.example.com

# Frontend build-time setting only when Pages and Worker are on separate origins.
# VITE_API_BASE_URL=https://your-worker.your-subdomain.workers.dev
