# Non-secret Vite variables only. VITE_* values are compiled into public browser files.
VITE_APP_NAME="Hendy App Store"
VITE_APP_URL="https://hendy-app-store.pages.dev"
VITE_ENVIRONMENT="development"
VITE_RELEASE_CHANNEL="stable"
VITE_APP_VERSION="3.3.0"

# Configure private values in GitHub Actions Secrets or Cloudflare Pages secrets.
# Never store these values in this file:
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# CF_ACCESS_ADMIN_EMAILS
# CF_ACCESS_TEAM_DOMAIN
# CF_ACCESS_AUD
# RELEASE_PUBLISH_TOKEN
# CERTIFICATE_ENCRYPTION_KEY
