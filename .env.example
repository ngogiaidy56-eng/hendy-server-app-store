# Public application settings. Never commit production credentials.
NODE_ENV=development
PORT=10000
APP_NAME=Hendy App Store
ENVIRONMENT=development
RELEASE_CHANNEL=stable
PUBLIC_BASE_URL=http://localhost:10000
ALLOW_DEGRADED_START=true

# Use the Neon pooled PostgreSQL connection string for a persistent free database.
# Render Free Postgres expires after 30 days; do not use it as the only production store.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
PGSSLMODE=require
PGPOOL_MAX=3

# Required server-only secrets. Set them in Render Dashboard -> Environment.
# ADMIN_USERNAME
# ADMIN_PASSWORD (at least 20 characters)
# ADMIN_EMAIL
# RELEASE_PUBLISH_TOKEN (at least 32 random characters)
# CERTIFICATE_ENCRYPTION_KEY (Base64 encoding of exactly 32 random bytes)

# Optional Telegram App Store bot; keep both values server-side.
# BOT_TOKEN
# TELEGRAM_WEBHOOK_SECRET
