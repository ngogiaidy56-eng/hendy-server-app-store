# Render backend
NODE_ENV=development
PORT=10000
# PostgreSQL: leave blank only to use read-only RELEASES_JSON mode locally.
DATABASE_URL=
ADMIN_API_TOKEN=replace-with-a-long-random-secret
RELEASES_JSON=[]

# Cloudflare R2 S3-compatible credentials for binary uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Must be the HTTPS origin/custom domain configured for public objects in your R2 bucket.
R2_PUBLIC_BASE_URL=https://downloads.example.com

# For frontend builds hosted separately from the Render backend.
# This should be the Worker proxy origin, not the Render API origin, unless the Render API
# is configured with direct cross-origin CORS.
# VITE_API_BASE_URL=https://hendy-server-app-store-api.example.workers.dev
