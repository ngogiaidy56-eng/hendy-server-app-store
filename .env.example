# Non-secret local Vite configuration only.
# VITE_* values are compiled into browser assets; never put private keys here.
VITE_APP_NAME="Hendy Tools Platform & App Downloader"
VITE_APP_URL="https://hendy-tool-releas.ngogiaidy56.workers.dev"
VITE_ENVIRONMENT="development"
VITE_RELEASE_CHANNEL="stable"
VITE_APP_VERSION="3.2.0"

# Private values must be configured as Cloudflare Worker secrets or
# GitHub Actions secrets. Do not copy their values into this file:
# CLOUDFLARE_API_TOKEN
# RELEASE_PUBLISH_TOKEN
# CF_ACCESS_TEAM_DOMAIN
# CF_ACCESS_AUD
# CF_ACCESS_ADMIN_EMAILS
